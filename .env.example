# Microsoft SQL Server Database Configuration
SQL_SERVER=localhost,1433
SQL_DATABASE=RetailIntelligenceDW
SQL_USERNAME=sa
SQL_PASSWORD=change-me-use-a-strong-local-password
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=no
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_DIALECT_DRIVER=mssql+pymssql

# Pipeline & Dataset Configuration
DATASET_MODE=small
DATA_RAW_DIR=data/raw
DATA_SYNTHETIC_DIR=data/synthetic
DATA_PROCESSED_DIR=data/processed

# Application Settings
LOG_LEVEL=INFO
STREAMLIT_PORT=8501
FASTAPI_PORT=8000
